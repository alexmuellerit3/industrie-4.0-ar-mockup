# ==============================================================================
# CPS-i40 Industrie 4.0 - Umgebungsvariablen (.env)
# ==============================================================================

# --- Netzwerk & Ports ---
# Host-Port für WebApp / SCADA Leitstand (z. B. 80, 8080 oder 3000)
PORT=80
HOST_PORT=80
CONTAINER_PORT=80

# Externe Ports für MQTT Broker (Standard: 1883 TCP, 9001 WebSockets)
MQTT_HOST_PORT=1883
MQTT_WS_PORT=9001

# Externe Ports für MySQL Datenbank (Standard: 3306)
MYSQL_HOST_PORT=3306

# --- MySQL 8.0 24h Zeitreihenspeicher & Auto-DDL ---
MYSQL_HOST=cps-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=cps_telemetry
MYSQL_USER=cps_user
MYSQL_PASSWORD=cps_pass_2026
MYSQL_ROOT_PASSWORD=root_cps_2026
MYSQL_RETENTION_HOURS=24

# --- Anwendungs- & Protokoll-Einstellungen ---
NODE_ENV=production
ENABLE_WSS=false

# --- Watchtower Auto-Update Einstellungen ---
# Prüfintervall in Sekunden (z. B. 300 = alle 5 Minuten)
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true
