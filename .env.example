# ==============================================================================
# CPS-i40 Industrie 4.0 Umgebungskonfiguration (.env)
# ==============================================================================

# Beliebiger Port für den Docker-Container & Web-Service
# Standard: 80 (HTTP). Kann auf jeden beliebigen Port gesetzt werden (z. B. 8080, 3000, 5000).
PORT=80

# Optional: Getrennte Port-Bindung für Host und Container
# Beispiel: Host soll Port 8080 nutzen, Container intern Port 80:
# HOST_PORT=8080
# CONTAINER_PORT=80

# MQTT Broker Verbindung (interner Docker Mosquitto Broker oder extern)
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
