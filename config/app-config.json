{
  "dataSource": "websocket",
  "websocket": {
    "url": "ws://localhost:3000/ws/telemetry",
    "clientId": "cps-backend-ws",
    "reconnectPeriod": 3500,
    "connectTimeout": 4000
  },
  "mqtt": {
    "brokerUrl": "mqtt://localhost:1883",
    "clientId": "cps-backend",
    "reconnectPeriod": 5000,
    "connectTimeout": 4000,
    "topics": [
      "cps-i40/+/telemetry",
      "cps-i40/+/status",
      "cps-i40/+/fault",
      "cps-i40/+/command"
    ]
  },
  "api": {
    "mode": "websocket",
    "pollIntervalMs": 1500,
    "historyTtlMs": 300000
  },
